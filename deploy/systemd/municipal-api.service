[Unit]
Description=Smart Municipal Complaint Management System API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/municipal-api
EnvironmentFile=/var/www/municipal-api/.env
Environment=PYTHONPATH=/var/www/municipal-api
ExecStart=/var/www/municipal-api/venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=municipal-api

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
