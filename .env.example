# ─── Database (SQLite) ────────────────────────────────────────
DATABASE_URL=sqlite:///./municipal_complaints.db

# ─── Security ───────────────────────────────────────────────
# أنشئ مفتاحاً عشوائياً: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Application ────────────────────────────────────────────
DEBUG=false
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ─── Firebase (إشعارات Push) ────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# ─── CORS ───────────────────────────────────────────────────
# * للسماح للجميع (غير موصى به في الإنتاج)
# CORS_ORIGINS=*
# أو حدّد نطاقات التطبيقات:
# CORS_ORIGINS=https://api.example.com,https://admin.example.com
